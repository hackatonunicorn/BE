# ===========================================
# Startup VC Platform - Production Environment
# ===========================================

# Основные настройки приложения
PROJECT_NAME=Startup-VC Communication Platform
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG
API_V1_STR=/api/v1
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# CORS настройки (настройте под ваши домены)
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# ===========================================
# База данных PostgreSQL
# ===========================================
POSTGRES_SERVER=postgres
POSTGRES_USER=startup_vc_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_DATABASE_PASSWORD
POSTGRES_DB=startup_vc_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://startup_vc_user:CHANGE_THIS_SECURE_DATABASE_PASSWORD@postgres:5432/startup_vc_platform

# ===========================================
# Redis кэш и очереди
# ===========================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# Email настройки
# ===========================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=Startup-VC Platform
EMAIL_TEMPLATES_DIR=/app/app/email/templates

# ===========================================
# AI и машинное обучение
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ===========================================
# Безопасность и аутентификация
# ===========================================
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# ===========================================
# Файлы и загрузки
# ===========================================
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,jpg,jpeg,png,gif

# ===========================================
# Первый суперпользователь
# ===========================================
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ===========================================
# Мониторинг и логирование
# ===========================================
SENTRY_DSN=your-sentry-dsn-for-error-tracking
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD
PROMETHEUS_ENABLED=true
LOG_FILE=/app/logs/app.log

# ===========================================
# Резервное копирование
# ===========================================
BACKUP_ENABLED=true
BACKUP_S3_BUCKET=your-backup-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
BACKUP_RETENTION_DAYS=30

# ===========================================
# Интеграции
# ===========================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
CRM_API_URL=https://your-crm-api.com
CRM_API_KEY=your-crm-api-key

# ===========================================
# Celery настройки
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# Кэширование
# ===========================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# ===========================================
# Webhook настройки
# ===========================================
WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET
WEBHOOK_TIMEOUT=30

# ===========================================
# SSL и безопасность
# ===========================================
SSL_REDIRECT=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ===========================================
# Производительность
# ===========================================
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# ===========================================
# Отладка и разработка (только для dev)
# ===========================================
# DEBUG=true
# LOG_LEVEL=DEBUG
# RELOAD=true
