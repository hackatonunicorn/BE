# ===========================================
# Startup VC Platform - Production Environment
# ===========================================

# Основные настройки
PROJECT_NAME=Startup-VC Communication Platform
SECRET_KEY=your-secret-key-here-change-this-in-production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# База данных
POSTGRES_SERVER=localhost
POSTGRES_USER=startup_vc_user
POSTGRES_PASSWORD=secure_password_123_change_this
POSTGRES_DB=startup_vc_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql://startup_vc_user:secure_password_123_change_this@localhost:5432/startup_vc_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Безопасность
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
REFRESH_TOKEN_EXPIRE_DAYS=30

# Первый суперпользователь
FIRST_SUPERUSER=admin@startup-vc-platform.com
FIRST_SUPERUSER_PASSWORD=admin123

# Файлы и загрузки
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads
UPLOAD_DIR=/opt/startup-vc/uploads

# CORS (разрешить все домены)
BACKEND_CORS_ORIGINS=*

# Производительность
WORKERS=2

# Email (опционально - настройте если нужна отправка писем)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@startup-vc-platform.com
EMAILS_FROM_NAME=Startup-VC Platform

# AI (опционально - настройте если используете OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Логирование
LOG_FILE=/opt/startup-vc/logs/app.log
